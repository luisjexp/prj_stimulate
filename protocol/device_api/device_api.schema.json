{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arduino Joystick Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "message_type", "payload"],
  "properties": {
    "protocol": {
      "const": "device-api"
    },
    "version": {
      "const": "0.1"
    },
    "message_type": {
      "const": "arduino_joystick_1.sample"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time","x", "y", "b"],
      "properties": {
        "time": {"type": "integer"},
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "b": { "type": "integer" }
      }
    }
  }
}